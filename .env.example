# MongoDB Atlas connection string (required)
# Create a free cluster at https://cloud.mongodb.com
# Network Access: allow 0.0.0.0/0 for Vercel, or use Atlas + Vercel integration
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/theos?retryWrites=true&w=majority

# PIN ushers enter before scanning (set this in Vercel env)
USHER_PIN=change-me
